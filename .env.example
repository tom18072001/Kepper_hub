# Sao chép thành .env rồi đổi các giá trị "change-..." trước khi chạy docker compose.
# Tạo chuỗi ngẫu nhiên: openssl rand -hex 32

# PostgreSQL (chỉ chữ, số và . _ ~ -)
POSTGRES_PASSWORD=change-to-a-url-safe-password
POSTGRES_HOST_PORT=5434

# Khoá ký phiên đăng nhập — chuỗi ngẫu nhiên dài
JWT_SECRET=change-to-a-long-random-secret

# Địa chỉ mở ứng dụng (dùng cho CORS); nhiều địa chỉ cách nhau dấu phẩy
APP_ORIGIN=http://localhost:4000
APP_PORT=4000

# Tài khoản quản trị gốc tạo ở lần chạy đầu
ROOT_ADMIN_USERNAME=admin
ROOT_ADMIN_PASSWORD=change-me-2026

# true = tạo dữ liệu mẫu GIẢ (4 phòng ban, 7 tài khoản mật khẩu 12345678, 2 dự án) khi CSDL chưa có dự án
SEED_DEMO=false

# Lưu tệp đính kèm: local (volume Docker, mặc định) | minio (cần: docker compose --profile full)
STORAGE_DRIVER=local
MINIO_ROOT_USER=workhub-minio
MINIO_ROOT_PASSWORD=change-minio-password

# Xem trước Word (cần: docker compose --profile full). Để trống PREVIEW_URL nếu không dùng.
PREVIEW_URL=
# PREVIEW_URL=http://office-preview:4100
PREVIEW_TOKEN=change-to-64-hex-chars-from-openssl-rand-hex-32

# Sao lưu tự động (service "backup"): thư mục trên máy, số ngày giữ, giờ chạy (0-23, hai chữ số)
BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=02

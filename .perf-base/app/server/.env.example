# Dùng khi chạy server trực tiếp bằng Node (không qua Docker): cp .env.example .env
DATABASE_URL="postgresql://workhub:doi-mat-khau@localhost:5434/workhub"
JWT_SECRET="doi-chuoi-nay-thanh-mot-gia-tri-ngau-nhien-dai"
APP_ORIGIN="http://localhost:4000"
PORT=4000
ROOT_ADMIN_USERNAME="admin"
ROOT_ADMIN_PASSWORD="doi-mat-khau-nay"
SEED_DEMO="false"

# Lưu tệp: local | minio
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="workhub-attachments"

# Xem trước Word: để trống PREVIEW_URL thì gọi LibreOffice cục bộ (OFFICE_BIN)
PREVIEW_URL=""
PREVIEW_TOKEN=""
# OFFICE_BIN="C:\\Program Files\\LibreOffice\\program\\soffice.exe"

# Giới hạn API (yêu cầu/phút/IP, không áp cho đăng nhập) và proxy tin cậy
API_RATE_LIMIT=600
TRUST_PROXY="loopback, linklocal, uniquelocal"
